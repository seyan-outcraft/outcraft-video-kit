# Copy to .env and fill in. Both are free signups. Never commit .env.

# Brandfetch "starter key" — a Bearer token for the Brand API, not the short client ID.
# 100 free brand lookups. https://developers.brandfetch.com/register
BRANDFETCH_API_KEY=

# Optional. The logo-CDN client ID. No tool uses it today.
BRANDFETCH_CLIENT_ID=

# Firecrawl. Free plan, no card. https://www.firecrawl.dev
FIRECRAWL_API_KEY=
