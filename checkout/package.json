{
  "name": "checkout",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes hyperframes@0.8.20 preview",
    "check": "npx --yes hyperframes@0.8.20 check",
    "snapshot": "npx --yes hyperframes@0.8.20 snapshot --at 2.6,5.8,8.3,10.7,13.6,17.8,19.8,22.4,26.3,31.6,35.3,38.8,43.5,47.4 -o out/stills --no-end",
    "render": "npx --yes hyperframes@0.8.20 render --output out/outcraft-checkout-sound.mp4",
    "render:sfx": "npx --yes hyperframes@0.8.20 render --output out/outcraft-checkout-sfx-only.mp4 --variables \"{\\\"bgm\\\":false}\"",
    "render:silent": "npx --yes hyperframes@0.8.20 render --output out/outcraft-checkout-silent.mp4 --variables \"{\\\"bgm\\\":false,\\\"sfx\\\":false}\"",
    "render:all": "npm run render && npm run render:sfx && npm run render:silent",
    "audio": "node tools/gen-audio.mjs",
    "assets": "node tools/record-assets.mjs",
    "publish": "npx --yes hyperframes@0.8.20 publish"
  }
}
